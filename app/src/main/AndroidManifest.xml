<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- M2 Step 1: basic connectivity check (connected/not + transport) for the STATUS channel.
         Install-time, non-sensitive, no runtime prompt. Deliberately NOT requesting
         READ_PHONE_STATE — precise signal-strength bars are out of scope (M2 hard stop). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- M4: the floating QUARK trigger. SYSTEM_ALERT_WINDOW = "draw over other apps" (the one new
         capability this milestone touches; pre-approved in Build Spec §5 as a one-time Settings
         toggle — granted via the system overlay-settings screen, never a runtime dialog). The
         trigger lives in a foreground Service so it survives leaving QuantumOS; on API 34+ a
         foreground service must declare a type, and "specialUse" is correct for a persistent
         launcher overlay (no narrower type fits). POST_NOTIFICATIONS is declared for the minimal
         foreground-service notification; we do NOT prompt for it this milestone (M4 hard stop:
         request no permission beyond the overlay) — the service runs regardless. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Step 2: package visibility — required on Android 11+ to list launchable apps.
         Uses the narrowly-scoped query; NOT QUERY_ALL_PACKAGES (Play policy). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuantumOS">

        <activity
            android:name="com.quantumos.shell.ui.LauncherActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true">

            <!-- Original tappable-app entry point (keep) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Step 1: HOME declaration (M1). Installing this build makes Android OFFER
                 QuantumOS as a Home option — it does not take over silently. The system
                 will prompt "Use as Home" or the Director must set it in
                 Settings → Apps → Default apps → Home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- M4: the floating-trigger foreground service. Not exported — only QuantumOS starts it. -->
        <service
            android:name="com.quantumos.shell.overlay.QuarkTriggerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="persistent_floating_launcher_trigger" />
        </service>

        <!-- M5: the real QUARK Assistant View the floating trigger taps through to. Full-screen,
             excluded from recents (it's a momentary overlay, not a task), single-top so repeated
             taps don't stack copies. Shares the launcher's engine via QuantumRuntime. -->
        <activity
            android:name="com.quantumos.shell.overlay.QuarkAssistantActivity"
            android:exported="false"
            android:theme="@style/Theme.QuantumOS"
            android:enableOnBackInvokedCallback="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />
    </application>
</manifest>
