<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SIGNAL: link diagnostics (cellular/wifi/GPS/Bluetooth gauges), read-only measurement of the
         device's own connectivity. Docked into the launcher's single APK; no own applicationId or
         launcher intent-filter; reached only via an internal Intent from the HOME instrument
         console's SIGNAL tile. No INTERNET permission: a field-diagnostics tool that phones home
         defeats its own premise (Task Brief §2). The four dangerous permissions below gate one
         gauge each; RUN SCAN and the Wi-Fi gauge need none of them. -->

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application>
        <activity
            android:name="com.quantumos.signal.SignalActivity"
            android:exported="false"
            android:enableOnBackInvokedCallback="true" />
    </application>

</manifest>
