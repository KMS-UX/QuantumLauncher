<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nav -- tactical map/GPS module. Docked into the launcher's single APK (App Shell
         Integration, Phase 3): no own applicationId/launcher intent-filter -- reached only via an
         internal Intent from the HOME instrument console's MAPS tile. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <activity
            android:name="com.quantumos.nav.NavActivity"
            android:exported="false"
            android:enableOnBackInvokedCallback="true" />
    </application>

</manifest>
