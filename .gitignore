# Gradle build cache and daemon state — machine-local, never commit
.gradle/
build/
app/build/

# Android Studio / IntelliJ project files
.idea/
*.iml
local.properties

# APK outputs (uploaded as CI artifacts instead)
*.apk
*.aab

# Release signing — NEVER commit; back up these files externally before this container is reclaimed
app/release.keystore
keystore.properties

# QUARK Phase 2b — Kokoro model weights are fetched at runtime, never committed (~325MB).
app/src/main/assets/quark_voice/*.onnx
app/src/main/assets/quark_voice/voices-*.bin
